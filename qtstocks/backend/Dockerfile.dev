# Use our base image
FROM qtstocks-base:latest

# Set development-specific environment variables
ENV FLASK_APP=app.py \
    FLASK_DEBUG=1 \
    PYTHONBREAKPOINT=0

# Install development dependencies
RUN pip install --no-cache-dir \
    debugpy \
    watchdog[watchmedo] \
    flask[development] \
    pytest \
    pytest-cov \
    python-dotenv

# Copy the rest of the application
COPY . .

# Expose ports
EXPOSE 5555
EXPOSE 5678

# Command to run the application with hot reload and debugger
CMD ["watchmedo", "auto-restart", "--directory=/app", "--pattern=*.py", "--recursive", "--", "python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "-m", "flask", "run", "--debugger", "--host=0.0.0.0"] 